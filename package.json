{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test:proxy": "node --experimental-strip-types --test tests/proxy.test.ts --test-reporter=spec",
    "test:product-images": "node --experimental-strip-types --test tests/product-images.test.ts --test-reporter=spec",
    "test:architecture": "node --experimental-strip-types --test tests/architecture.test.ts --test-reporter=spec",
    "test:announcements-images": "node --experimental-strip-types --test tests/announcements-images.test.ts --test-reporter=spec",
    "test:calendar-time": "node --experimental-strip-types --test tests/calendar-time.test.ts --test-reporter=spec",
    "preview": "vite preview",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.2",
    "@types/pg": "^8.20.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "pg": "^8.22.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
