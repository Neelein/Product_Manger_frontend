{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "chrome": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-puppeteer"],
      "enabled": true
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp",
      "headers": {
        "Authorization": "Bearer <your-token>"
      }
    }
  }
}